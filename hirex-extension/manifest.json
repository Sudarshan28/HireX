{
  "manifest_version": 3,
  "name": "HireX Auto-Track Extension",
  "version": "1.0.0",
  "description": "Automatically tracks external job applications (Lever, Greenhouse, Workday) and syncs statuses directly with HireX.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:5000/*",
    "https://*.lever.co/*",
    "https://*.greenhouse.io/*",
    "https://*.workday.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["hirex_bridge.js"],
      "run_at": "document_end"
    },
    {
      "matches": [
        "https://*.lever.co/*",
        "https://*.greenhouse.io/*",
        "https://*.workday.com/*"
      ],
      "js": ["ats_tracker.js"],
      "run_at": "document_end"
    }
  ]
}
